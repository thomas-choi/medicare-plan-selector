# Medicare Plan Selector — environment template. `cp .env.example .env` (chmod 600, never committed).
# The repo ships no keys. Values below work as-is for the LOCAL dev stack (`make stack-up`); the dev passwords are
# the public, local-only ones from docker-compose.yml and deploy/mysql/01-roles.sql.
# Production: see deploy/README.md (real passwords, container host names mysql:3306 / redis:6379).
#
# Blank numeric/boolean values (KEY=) mean "use the default".
# Keep comments on their OWN lines: Docker Compose `env_file` does not strip `KEY=   # note`, the value would become
# "# note" (tests/unit/test_config.py checks this file).

# ---- Databases (three roles; DESIGN §4) ----
# Host-side commands (make migrate / ingest-dev / api-dev, uv run selector ...) use the published ports
# 127.0.0.1:3307 (MySQL) and 127.0.0.1:6380 (Redis). With these local URLs the dev compose `api` container ignores
# them and uses the service names instead (override with COMPOSE_DATABASE_URL etc. if you need to).
# Redis is app-local (DESIGN-v0.4-ADDENDUM A10): keep REDIS_URL on 127.0.0.1:6380 even when MySQL is elsewhere.
# Live-data MySQL (192.168.0.216:3306, msp_dev_* accounts): put it in the three DB URLs only. `make stack-up` then
# checks that MySQL and starts only the local Redis; the `api` container reaches that Redis as redis:6379. Never run
# `make ingest-dev` against it. Tests always use this machine's MySQL, whatever is here. Details: docs/OPERATION.md.
DATABASE_URL=mysql+pymysql://msp_api:dev-api-pw@127.0.0.1:3307/msp
INGEST_DATABASE_URL=mysql+pymysql://msp_ingest:dev-ingest-pw@127.0.0.1:3307/msp
MIGRATOR_DATABASE_URL=mysql+pymysql://msp_migrator:dev-migrator-pw@127.0.0.1:3307/msp
REDIS_URL=redis://:dev-redis-pw@127.0.0.1:6380/0
REDIS_PASSWORD=dev-redis-pw
# Containers (docker-compose.prod.yml requires these; the dev compose defaults to the dev service URLs):
# COMPOSE_DATABASE_URL=mysql+pymysql://msp_api:<api-pw>@mysql:3306/msp
# COMPOSE_REDIS_URL=redis://:<redis-pw>@redis:6379/0
# MYSQL_ROOT_PASSWORD=<prod only>

# ---- Sessions and privacy (DESIGN §8.1, §8.5) ----
# nosave | saved
DEFAULT_SESSION_MODE=nosave
RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=365
EPHEMERAL_IDLE_MINUTES=30
EPHEMERAL_MAX_HOURS=4
EPHEMERAL_END_GRACE_SECONDS=60
# Needed for Saved mode. 32 random bytes, base64:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PROFILE_ENC_KEY=
PROFILE_KEY_VERSION=1
# true in production (HTTPS); false only for plain-HTTP local testing
COOKIE_SECURE=false
# Optional pepper for per-IP quota keys (they are already HMACs with a random daily salt kept in Redis).
IP_HASH_SECRET=

# ---- LLM provider (DESIGN §6.4) ----
# anthropic (default per DESIGN §6.4) | xai | openai_compat | fake (scripted, no network) | blank = no-LLM mode
LLM_PROVIDER=fake
# Examples (put the key in the matching *_API_KEY line; never commit it):
#   Anthropic:            LLM_PROVIDER=anthropic      LLM_MODEL=<Anthropic model id>   ANTHROPIC_API_KEY=...
#   xAI:                  LLM_PROVIDER=xai            LLM_MODEL=<xAI model id>         XAI_API_KEY=...
#   NVIDIA API catalog:   LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#                         LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b             OPENAI_COMPAT_API_KEY=nvapi-...
#   (any OpenAI-compatible endpoint works the same way with openai_compat + LLM_BASE_URL)
# pinned model id; recorded per message
LLM_MODEL=
# openai_compat only; xai defaults to https://api.x.ai/v1
LLM_BASE_URL=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=
# used on 5xx/timeout/rate-limit; never on validator failure
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.2
# The model's list price in USD per million tokens. Set both for real usage: while blank, cost counts as 0 and the
# LLM_DAILY_BUDGET_USD cap never triggers (only the per-session turn/token caps apply).
# USD per million input tokens
LLM_PRICE_IN_PER_MTOK_USD=
# USD per million output tokens
LLM_PRICE_OUT_PER_MTOK_USD=

# ---- Quotas and abuse controls (DESIGN §8.2) ----
LLM_DAILY_BUDGET_USD=10
MAX_TURNS_PER_SESSION=40
MAX_TOKENS_PER_SESSION=200000
# local testing; production: 5 (DESIGN §8.2 default)
MAX_SESSIONS_PER_IP_PER_DAY=200
# none | turnstile | hcaptcha (post-MVP)
CAPTCHA_PROVIDER=none

# ---- Admin (DESIGN §7, Q2) ----
# nginx adds `X-Admin-Gate: <this>` after basic auth + IP allowlist. Blank = admin API disabled.
ADMIN_GATE_SECRET=

# ---- External lookups ----
# optional; see docs/design/HUD-API-SETUP.md (fallback: selector hud load-file)
HUD_API_TOKEN=
HUD_API_BASE=https://www.huduser.gov/hudapi/public/usps

# ---- Doctor directory checks (design v0.4 addendum A3; optional, defaults shown) ----
# Only NPIs are sent to carriers' public provider directories and to the CMS opt-out list; nothing is stored.
# DIRECTORY_BUDGET_S=8            # longest a comparison waits for directory answers; slower = "can't check"
# DIRECTORY_MIN_INTERVAL_S=1      # seconds between requests to one carrier host
# OPTOUT_URL=https://data.cms.gov/data-api/v1/dataset/cc4e7ff6-9433-4765-b073-8bf1ce09093b/data
# OPTOUT_VINTAGE=Opt Out Affidavits 2026-09-01

# ---- Docker / deploy ----
# image: ${DOCKER_USER}/medicare-plan-selector:${IMAGE_TAG}
DOCKER_USER=local
IMAGE_TAG=latest
# runtime user inside the images
APP_UID=10001
APP_GID=10001
# web UI container on http://127.0.0.1:8080 (prod: host nginx proxies to it)
MSP_WEB_PORT=8080
# Host IP the dev web UI binds to. Blank/unset = 127.0.0.1 (this machine only; use `ssh -L` from elsewhere).
# For LAN access set this machine's LAN IP, e.g. 192.168.0.216 (then open http://192.168.0.216:8080; loopback no
# longer answers). 0.0.0.0 = every interface. No login protects the dev UI: only do this on a trusted network.
MSP_WEB_BIND=127.0.0.1
# Host IP the dev MySQL (:3307) and Redis (:6380) bind to. Blank/unset = 127.0.0.1. Only set a LAN IP to share
# this machine's whole dev stack with another host (then `make stack-down && make stack-up && make ingest-dev`).
# A coding host that uses the live-data MySQL leaves this blank, so its Redis stays on loopback. Trusted LAN only.
MSP_DB_BIND=
# Optional: the dev MySQL host when it can't be read from the URLs above (decides local vs. remote MySQL; not Redis).
MSP_DB_HOST=
# dev compose only: API published on 127.0.0.1
MSP_API_PORT=8000
# production nginx HTTPS port
MED_PUBLIC_PORT=443
PLAN_YEAR=2027
