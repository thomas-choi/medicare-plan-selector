# Medicare Plan Selector — environment template. Copy to `.env` on the server (mode 600, never committed).
# Every value below is a placeholder. The repo ships no keys.

# ---- Databases (three roles; DESIGN §4) ----
DATABASE_URL=mysql+pymysql://msp_api:CHANGE_ME@mysql:3306/msp
INGEST_DATABASE_URL=mysql+pymysql://msp_ingest:CHANGE_ME@mysql:3306/msp
MIGRATOR_DATABASE_URL=mysql+pymysql://msp_migrator:CHANGE_ME@mysql:3306/msp
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# ---- Sessions and privacy (DESIGN §8.1, §8.5) ----
DEFAULT_SESSION_MODE=nosave          # nosave | saved
RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=365
EPHEMERAL_IDLE_MINUTES=30
EPHEMERAL_MAX_HOURS=4
EPHEMERAL_END_GRACE_SECONDS=60
# 32 random bytes, base64: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PROFILE_ENC_KEY=
PROFILE_KEY_VERSION=1
COOKIE_SECURE=true

# ---- LLM provider (DESIGN §6.4) ----
LLM_PROVIDER=                        # anthropic | openai_compat | fake  (openai, ollama: post-MVP)
LLM_MODEL=                           # pinned model id; recorded per message
LLM_BASE_URL=                        # openai_compat only (e.g. an xAI or other OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=
LLM_FALLBACK_PROVIDER=               # used on 5xx/timeout/rate-limit; never on validator failure
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.2
LLM_PRICE_IN_PER_MTOK_USD=
LLM_PRICE_OUT_PER_MTOK_USD=

# ---- Quotas and abuse controls (DESIGN §8.2) ----
LLM_DAILY_BUDGET_USD=10
MAX_TURNS_PER_SESSION=40
MAX_TOKENS_PER_SESSION=200000
MAX_SESSIONS_PER_IP_PER_DAY=5
CAPTCHA_PROVIDER=none                # none | turnstile | hcaptcha

# ---- External lookups ----
HUD_API_TOKEN=                       # see docs/design/HUD-API-SETUP.md
HUD_API_BASE=https://www.huduser.gov/hudapi/public/usps

# ---- Deploy ----
MED_PUBLIC_PORT=443
PLAN_YEAR=2027
